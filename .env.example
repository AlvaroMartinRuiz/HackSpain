# ---- Platform (the desk gives you these) -----------------------------
PLATFORM_API_KEY=pk-your-key-here
PLATFORM_API_BASE_URL=https://hackspain.getprosperapp.com/api/v1

# ---- Server ----------------------------------------------------------
# The console and the call socket share this port. ngrok points here.
PORT=7860
# ngrok dials from this machine, so loopback is enough. 0.0.0.0 would publish
# the console, and the patient data on it, to the whole venue network.
HOST=127.0.0.1
# Restarts the server on every file save. Useful while building, and a way to
# lose ten live calls at once during a Run All. Leave it off unless editing.
RELOAD=false

# Public addresses the platform and the rest of the team use.
# Register PUBLIC_WS_URL in the challenge dashboard (scheme + /ws).
PUBLIC_WS_URL=wss://your-tunnel.ngrok-free.dev/ws
PUBLIC_CONSOLE_URL=https://your-tunnel.ngrok-free.dev/

# ---- Speech to text --------------------------------------------------
# Deepgram streams 8 kHz mulaw natively and does its own endpointing, which is
# what makes barge-in possible. Without a key the agent falls back to Whisper,
# which works but waits for the pause.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "multi" lets a caller switch language mid-call without a restart.
DEEPGRAM_LANGUAGE=multi
# Optional endpointing controls (defaults shown).
STT_ENDPOINTING_MS=300
STT_UTTERANCE_END_MS=1000

# ---- The model -------------------------------------------------------
# Any OpenAI-compatible endpoint, so a gateway needs no code change:
#   Vercel      LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
#               LLM_MODEL=openai/gpt-4o
#   Cloudflare  LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
#               LLM_MODEL=openai/gpt-4o
#               LLM_EXTRA_HEADERS=cf-aig-gateway-id: <gateway>
# Gateways expect the model as "provider/model"; direct OpenAI expects "gpt-4o".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_EXTRA_HEADERS=
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ROUNDS=6

# ---- Text to speech --------------------------------------------------
# Deepgram Aura and ElevenLabs return mulaw directly; OpenAI is converted locally.
# ElevenLabs remains primary; Deepgram is the automatic low-cost fallback.
TTS_PROVIDER=elevenlabs
DEEPGRAM_TTS_MODEL_ES=aura-2-silvia-es
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Call behaviour --------------------------------------------------
AGENT_GREETING=Clínica Arenal, buenos días. ¿En qué puedo ayudarle?
# The harness cuts a call at three minutes; close the record before that.
CALL_HARD_LIMIT_S=170
SUBMIT_DEADLINE_S=25
BARGE_IN=true

# ---- Observability ---------------------------------------------------
# Optional; defaults are data/calls.db and data/catalog.json.
DB_PATH=
CATALOG_PATH=
