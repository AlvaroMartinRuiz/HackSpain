# ---- Platform (the desk gives you these) -----------------------------
PLATFORM_API_KEY=pk-your-key-here
PLATFORM_API_BASE_URL=https://hackspain.getprosperapp.com/api/v1

# ---- Server ----------------------------------------------------------
# The console and the call socket share this port. ngrok points here.
PORT=7860
# Local: 127.0.0.1. Deploy: 0.0.0.0 so the platform can bind the public port.
HOST=127.0.0.1
# Restarts the server on every file save. Useful while building, and a way to
# lose a live scored call (or twenty Switchboard sockets). Leave it off unless editing.
RELOAD=false

# Public addresses the platform and the rest of the team use.
# Register PUBLIC_WS_URL in the challenge dashboard (scheme + /ws).
PUBLIC_WS_URL=wss://your-tunnel.ngrok-free.dev/ws
PUBLIC_CONSOLE_URL=https://your-tunnel.ngrok-free.dev/

# ngrok publishes the whole port, console included, and the console shows
# patient data. Through the tunnel it needs this token: open it once as
# https://your-tunnel.ngrok-free.dev/?token=<CONSOLE_TOKEN> and a cookie keeps
# you in. Empty means the console answers only on this machine. /ws and /health
# never need it. Generate one: python -c "import secrets;print(secrets.token_urlsafe(18))"
CONSOLE_TOKEN=

# ---- Speech to text --------------------------------------------------
# Nova-3 streams the phone line's µ-law 8 kHz with numerals and barge-in
# partials. Scribe remains a switch:
#   STT_PROVIDER=elevenlabs
STT_PROVIDER=deepgram
ELEVENLABS_STT_MODEL=scribe_v2_realtime
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "multi" lets a caller switch language mid-call without a restart.
DEEPGRAM_LANGUAGE=multi
# Wait for a pause so we never cut the caller off mid-sentence.
STT_ENDPOINTING_MS=800
STT_UTTERANCE_END_MS=1200
# Deepgram-only: discard very uncertain noise instead of giving it to the LLM.
STT_MIN_CONFIDENCE=0.45
# Scribe-only: drop a TV or traffic bed before it becomes a false barge-in.
STT_FILTER_BACKGROUND=true

# ---- The model -------------------------------------------------------
# Any OpenAI-compatible endpoint, so a gateway needs no code change:
#   Vercel      LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
#               LLM_MODEL=openai/gpt-4o
#   Cloudflare AI Gateway (the $100 of credits; requests show in its Logs):
#               LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat
#               LLM_MODEL=openai/gpt-4o
#               LLM_EXTRA_HEADERS=
#     Also works with the same token (tested): the Workers AI URL plus the
#     gateway header. Pick one; do not mix the URL of one with the other.
#               LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
#               LLM_EXTRA_HEADERS=cf-aig-gateway-id: <gateway>
# Gateways expect the model as "provider/model"; direct OpenAI expects "gpt-4o".
# Scored path: gpt-4o through Cloudflare AI Gateway. Empty LLM_REASONING_EFFORT
# omits the field (gpt-4o does not take it).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
LLM_MODEL=openai/gpt-4o
LLM_EXTRA_HEADERS=cf-aig-gateway-id: <gateway>
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=
# Tool rounds through the gateway often take longer than 20s; 20s sounds like a drop.
LLM_TIMEOUT_S=60
LLM_CONCURRENCY=8
LLM_MIN_GAP_S=0
LLM_MAX_TOOL_ROUNDS=6

# ---- Text to speech --------------------------------------------------
# ElevenLabs on the line; Aura (TTS_PROVIDER=deepgram) is the cheap
# practice voice and the automatic fallback if Flash 429s.
TTS_PROVIDER=elevenlabs
DEEPGRAM_TTS_MODEL_ES=aura-2-silvia-es
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Native accents. Spanish/Catalan use Gin (peninsular); English uses Sarah.
ELEVENLABS_VOICE_ID_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_ES=DPwFpA8IrumLrL4D7PBE
ELEVENLABS_MODEL=eleven_flash_v2_5
# Used only after this call is detected as Catalan (Flash has no Catalan);
# optimized for conversation, ~0.5 s slower.
ELEVENLABS_CATALAN_MODEL=eleven_v3_conversational
# Concurrent requests per account (Creator: 10 with Flash).
ELEVENLABS_CONCURRENCY=10
DEEPGRAM_TTS_CONCURRENCY=15
# Synthesise the greeting and fixed lines once at start-up (~300 characters).
TTS_WARM_CACHE=true
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Call behaviour --------------------------------------------------
# Bilingual: 69 of the 73 public cases are in English.
AGENT_GREETING=Clínica Arenal, good morning, buenos días. How can I help?
# Language until the caller's is detected.
DEFAULT_LANGUAGE=en
# The harness cuts a call at three minutes; close the record before that.
CALL_HARD_LIMIT_S=145
SUBMIT_DEADLINE_S=25
BARGE_IN=true
PLAYBACK_LEAD_MS=60
AGENT_HOLD_S=3.0
# Pipecat LocalSmartTurn v3: the agent does not start a reply until the
# caller has actually finished. Deepgram still transcribes; we only wait.
SMART_TURN=true
SMART_TURN_STOP_SECS=1.2
# After the agent stops talking: ask "Are you still there?" after this many
# seconds of silence, at most this many times in a row.
SILENCE_PROMPT_S=16
SILENCE_PROMPT_MAX=2

# After a booking, reschedule, cancel or registration: compose a confirmation
# email. The console and data/emails/ always get a copy. Resend only sends if
# a key is set. Never delays the Prosper submit.
FOLLOWUP_EMAIL=true
FOLLOWUP_FROM=Clínica Arenal <onboarding@resend.dev>
# Optional inbox that always receives a copy (jury / team).
FOLLOWUP_COPY=
RESEND_API_KEY=
# Optional. Resend's test domain can only deliver to the account inbox.
# Gmail SMTP (app password) can send to the address said on the call.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Slower TTS only when the patient note says they are hard of hearing.
# Flip off immediately if a live call sounds wrong.
ACCESSIBILITY_VOICE=true

# ---- Design assets (QuiverAI) ----------------------------------------
# Quiver generates SVG. It is used once, by scripts/generate_assets.py, to draw
# the console's icon set; the SVGs are committed and served from disk, so the
# dashboard costs nothing to open and works offline. Leave QUIVER_MODEL empty
# and the generator picks from whatever /v1/models offers this key.
QUIVER_API_KEY=
QUIVER_MODEL=

# ---- Observability ---------------------------------------------------
# Optional; defaults are data/calls.db and data/catalog.json.
DB_PATH=
CATALOG_PATH=
