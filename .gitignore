dist/
build/
*.log
.DS_Store

# The call history and the desk file are committed so a clone can replay the
# demo. Their sqlite sidecars are per-process and must not be: a -wal from
# another machine is read as pending writes against a database it never saw.
data/calls.db-shm
data/calls.db-wal
data/ops-smoke.db
data/ops-smoke.db-*
data/recordings/
data/emails/

# Local IDE / review dumps. Never ship these.
.cursor/
.review-alvaro/
openapi.json

# Server output when it is started detached.
server.out
server.err
server.pid
ngrok.out
ngrok.err

